/*
 * ============================================================
 * NanoHIV-DR
 * Docker / local configuration
 * ============================================================
 */


/*
 * ============================================================
 * Parameters
 * ============================================================
 */

params {

    /*
     * User inputs
     */
    pod5 = null
    metadata = null
    consensus = null

    /*
     * Pipeline stage
     */
    stage = ''

    /*
     * Output
     */
    outdir = 'results'

    /*
     * General
     */
    threads = 8
    device = 'auto'
    max_retries = 2

    /*
     * Dorado
     */
    dorado_model = 'dna_r10.4.1_e8.2_400bps_sup@v5.2.0'
    kit_name = 'SQK-NBD114-96'

    /*
     * NanoQ
     */
    min_quality = 15
    min_length = 800
    max_length = 1200

    /*
     * Human reference
     */
    human_ref = "${baseDir}/references/Human/human_g1k_v37.fasta"

    /*
     * HIV reference
     */
    hiv_ref = "${baseDir}/references/HIV/HXB2-pol.fasta"
    hiv_index = "${baseDir}/references/HIV/HXB2-pol.mmi"

    /*
     * iVar consensus
     */
    ivar_min_quality = 15
    ivar_threshold = 0.5
    ivar_min_depth = 20
    ivar_max_depth = 5000

    /*
     * DRM-LINK (optional read-backed linkage module)
     */
    drm_targets = "${baseDir}/references/HIV/drm_targets.tsv"
    chimera_floor = 0.0
    linkage_min_mapq = 20
    linkage_min_cocov = 50

    /*
     * CodFreq
     */
    codfreq_profile = "${baseDir}/references/HIV/HIV1.json"

    /*
     * Metadata
     */
    metadata_id_column = 'sample_id'

    /*
     * Reporting
     */
    hiv_alignment =
        "${baseDir}/references/HIV/HIV_aligned_references.fasta"
}


/*
 * ============================================================
 * Docker
 * ============================================================
 */

docker {

    enabled = true

    /*
     * The image was built as linux/amd64.
     *
     * The Mac is Apple Silicon (arm64), therefore Docker Desktop
     * must run the container through amd64 emulation.
     */
    runOptions = '--platform linux/amd64'
}


/*
 * ============================================================
 * Global process configuration
 * ============================================================
 */

process {

    /*
     * NanoHIV-DR Docker image
     */
    container = 'nanohiv-dr-cpu:latest'

    /*
     * Default CPU allocation
     */
    cpus = params.threads

    /*
     * Per-process failure handling.
     *
     * Transient failures (a container hiccup, a memory blip,
     * a flaky network call) are retried up to
     * params.max_retries times. A process that still fails is
     * then skipped ('ignore') rather than aborting the whole
     * batch, so one bad sample does not lose the good ones.
     *
     * IMPORTANT: a skipped sample is dropped SILENTLY by
     * Nextflow. Always check the execution report/trace
     * (enabled below) and confirm the number of consensus
     * sequences matches the number of input samples before
     * treating a run as complete.
     */
    errorStrategy = { task.attempt <= params.max_retries ? 'retry' : 'ignore' }
    maxRetries = params.max_retries
}


/*
 * ============================================================
 * Process-specific resources
 * ============================================================
 */

process {

    withName: DORADO_BASECALL {

        cpus = 8

    }

    withName: DORADO_DEMUX {

        cpus = 8

    }

    withName: SANITIZEME {

        cpus = 8

    }

    withName: NANOQ {

        cpus = 8

    }

    withName: IVAR_CONSENSUS {

        cpus = 2

    }

    withName: MINIMAP2 {

        cpus = 8

    }

    withName: CODFREQ {

        cpus = 8

    }

    withName: HIVDB_READS {

        cpus = 1
        errorStrategy = 'terminate'

    }

    withName: CHECKPOINT_CONSENSUS {

        cpus = 2
        errorStrategy = 'terminate'

    }

    withName: VALIDATE_METADATA {

        cpus = 2
        errorStrategy = 'terminate'

    }

    withName: REPORT {

        cpus = 4
        errorStrategy = 'terminate'

    }
}


/*
 * ============================================================
 * Trace
 * ============================================================
 */

trace {

    enabled = true

    overwrite = true
}


/*
 * ============================================================
 * Execution report
 * ============================================================
 */

report {

    enabled = true

    overwrite = true
}


/*
 * ============================================================
 * Timeline
 * ============================================================
 */

timeline {

    enabled = true

    overwrite = true
}


/*
 * ============================================================
 * Profiles
 * ============================================================
 */

profiles {

    /*
     * Quick test using public HIV-1 Nanopore reads.
     *
     * Fetch the data first with:
     *     bin/fetch_test_data.sh
     *
     * Then run:
     *     nextflow run main.nf -profile test
     *
     * These are near-full-length reads, so the NanoQ length
     * window is widened relative to the ~1 kb amplicon default.
     */
    test {

        params.stage      = 'consensus'
        params.fastq      = "${baseDir}/data/example/*.fastq.gz"
        params.min_length = 800
        params.max_length = 12000
        params.outdir     = 'results_test'
    }
}
